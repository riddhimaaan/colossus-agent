{
  "$schema": "https://app.kilo.ai/config.json",
  "default_agent": "agent",
  "model": "openrouter/deepseek/deepseek-v4-flash",
  "small_model": "openrouter/deepseek/deepseek-v4-flash",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "lsp": "deny",
    "codebase_search": "deny",
    "semantic_search": "deny",
    "repo_clone": "deny",
    "repo_overview": "deny",
    "plan_enter": "deny",
    "plan_exit": "deny"
  }
}
