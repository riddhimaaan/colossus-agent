#!/usr/bin/env bash
set -euo pipefail

# Resolve the real file first: `colossus` is a symlink in ~/.local/bin.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
runtime="$root/.runtime"
launch_directory="$PWD"
host_home="$HOME"
# Settings live in the user's home config, the way Kilo uses ~/.config/kilo.
# Captured from the real HOME before it is remapped into .runtime/ below.
config_dir="${COLOSSUS_CONFIG_DIR:-$host_home/.config/colossus}"
key_file="$config_dir/openrouter-api-key"
legacy_key_file="$host_home/.config/creative-cli/openrouter-api-key"

# Create the settings home on first run so a fresh install has somewhere to put
# skills without the user having to make the folders by hand.
mkdir -p "$config_dir"/{skills,command,agent}

# Seed the starter profile so a fresh clone launches with a model and a
# permission baseline already set. Only ever fills in a missing file, so an
# edited profile survives every later launch and every `git pull`.
for seed in kilo.jsonc AGENTS.md; do
  [[ -e "$config_dir/$seed" ]] || cp "$root/profile/$seed" "$config_dir/$seed"
done

# A user-created, owner-only key file is the source of truth. Prefer it over
# inherited terminal variables: old shell tabs can otherwise retain a revoked
# key and cause intermittent-looking OpenRouter 401 errors.
if [[ -r "$key_file" ]]; then
  export OPENROUTER_API_KEY
  OPENROUTER_API_KEY="$(tr -d '\r\n' < "$key_file")"
elif [[ -r "$legacy_key_file" ]]; then
  # Preserve the existing setup while Colossus adopts its own config path.
  export OPENROUTER_API_KEY
  OPENROUTER_API_KEY="$(tr -d '\r\n' < "$legacy_key_file")"
fi

export HOME="$runtime/home"
export XDG_CONFIG_HOME="$runtime/config"
export XDG_DATA_HOME="$runtime/data"
export XDG_CACHE_HOME="$runtime/cache"
export XDG_STATE_HOME="$runtime/state"
export KILO_CONFIG_DIR="$config_dir"
export KILO_DISABLE_EXTERNAL_SKILLS=1
# Permit skills and MCP/config files in the user's active workspace. The source
# checkout itself carries Kilo's bundled coding material, so keep project config
# disabled only when Colossus is launched from inside that checkout.
case "$launch_directory" in
  "$root"|"$root"/*) export KILO_DISABLE_PROJECT_CONFIG=1 ;;
  *) unset KILO_DISABLE_PROJECT_CONFIG ;;
esac
# The source runtime needs its own working directory, while this tells the TUI
# which folder the user actually launched Colossus from.
export KILO_DEV_CWD="$launch_directory"

if [[ "${1:-}" == "prompt" && "${2:-}" == "show" ]]; then
  # Print the whole file: a line cap would silently break the transparency
  # promise as soon as the prompt grows past it.
  cat "$root/packages/opencode/src/session/prompt/creative-core.txt"
  exit 0
fi

if [[ "${1:-}" == "doctor" ]]; then
  if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
    echo "OpenRouter: no OPENROUTER_API_KEY is available to Colossus."
    echo "Set it in the terminal before launching: export OPENROUTER_API_KEY='...'."
    exit 1
  fi

  response="$(curl --silent --show-error --max-time 15 \
    --write-out $'\n%{http_code}' \
    --header "Authorization: Bearer ${OPENROUTER_API_KEY}" \
    https://openrouter.ai/api/v1/auth/key)"
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"

  if [[ "$status" == "200" ]]; then
    echo "OpenRouter: connected. The API key is valid."
    if [[ "${2:-}" == "chat" ]]; then
      chat_response="$(curl --silent --show-error --max-time 30 \
        --write-out $'\n%{http_code}' \
        --header "Authorization: Bearer ${OPENROUTER_API_KEY}" \
        --header "Content-Type: application/json" \
        --data '{"model":"deepseek/deepseek-v4-flash","messages":[{"role":"user","content":"Reply READY"}],"max_tokens":2}' \
        https://openrouter.ai/api/v1/chat/completions)"
      chat_status="${chat_response##*$'\n'}"
      if [[ "$chat_status" == "200" ]]; then
        echo "OpenRouter: model generation works."
      else
        echo "OpenRouter: this key cannot generate with the selected model (HTTP $chat_status)."
        echo "${chat_response%$'\n'*}" | sed -E 's/(sk-or-v1-)[A-Za-z0-9_-]+/\1[REDACTED]/g'
        exit 1
      fi
    fi
    if [[ "${2:-}" == "model" ]]; then
      # Default to the model profile/kilo.jsonc actually pins, so the check
      # reports on the model a real session would use.
      model_id="${3:-deepseek/deepseek-v4-flash}"
      model_response="$(curl --silent --show-error --max-time 15 \
        --write-out $'\n%{http_code}' \
        --header "Authorization: Bearer ${OPENROUTER_API_KEY}" \
        "https://openrouter.ai/api/v1/models/${model_id}")"
      model_status="${model_response##*$'\n'}"
      if [[ "$model_status" == "200" ]]; then
        echo "Model: ${model_id} is available to this key."
      else
        echo "Model: ${model_id} is not available (HTTP $model_status)."
        echo "${model_response%$'\n'*}" | sed -E 's/(sk-or-v1-)[A-Za-z0-9_-]+/\1[REDACTED]/g'
        exit 1
      fi
    fi
    exit 0
  fi

  echo "OpenRouter: rejected the configured API key (HTTP $status)."
  echo "$body" | sed -E 's/(sk-or-v1-)[A-Za-z0-9_-]+/\1[REDACTED]/g'
  exit 1
fi

if command -v bun >/dev/null 2>&1; then
  bun_bin="$(command -v bun)"
elif [[ -x /usr/bin/bun ]]; then
  bun_bin="/usr/bin/bun"
elif [[ -x "$host_home/.bun/bin/bun" ]]; then
  # Use the caller's real home: HOME now points into .runtime/ for isolation.
  bun_bin="$host_home/.bun/bin/bun"
else
  echo "Colossus needs Bun, but it was not found." >&2
  exit 1
fi

# The runtime source lives in this fork, but an ordinary launch should operate
# on the caller's folder. Passing it as the TUI project makes its local skills
# and configuration discoverable.
if [[ "$#" -eq 0 ]]; then
  set -- "$launch_directory"
fi

exec "$bun_bin" run --cwd "$root/packages/opencode" --conditions=node src/index.ts "$@"
